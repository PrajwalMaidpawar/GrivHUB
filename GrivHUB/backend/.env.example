# ==============================================================================
# GrievanceHUB Backend Environment Configuration Template
# COPY TO .env IN PRODUCTION AND FILL WITH ACTUAL SECURE VALUES
# DO NOT COMMIT REAL CREDENTIALS OR SECRET KEYS TO VERSION CONTROL
# ==============================================================================

# Django Core Settings
DEBUG=False
DJANGO_SECRET_KEY=<generate_strong_random_secret_key_minimum_50_chars>
ALLOWED_HOSTS=127.0.0.1,localhost,api.grievancehub.gov.in,your-domain.com

# Server Binding
PORT=8005
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated URLs of deployed frontend applications)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://grievancehub.gov.in,https://admin.grievancehub.gov.in

# MongoDB Database Connection
# Production connection string with authentication and SSL enabled
MONGODB_URI=mongodb://<db_user>:<db_password>@<mongodb_host>:27017/<database_name>?authSource=admin&retryWrites=true&w=majority
MONGODB_DATABASE=grievancehub_production

# Machine Learning Service Configuration
ML_ARTIFACTS_DIR=backend/ml_artifacts
ML_REVIEW_THRESHOLD=0.75
ML_AUTO_LOAD=True

# Rate Limiter Thresholds (requests per minute)
RATE_LIMIT_SUBMIT_PER_MIN=30
RATE_LIMIT_CLASSIFY_PER_MIN=60
RATE_LIMIT_ADMIN_PER_MIN=60
RATE_LIMIT_DEFAULT_PER_MIN=180

# Logging & Monitoring
LOG_LEVEL=INFO
