# GrievanceHUB Environment Configuration Template
# Copy this file to .env and customize for local environment

# Django Backend Configuration
DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Primary PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=grievancehub
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Machine Learning Engine Settings
ML_ARTIFACTS_DIR=ml/artifacts/final
ML_REVIEW_THRESHOLD=0.75
ML_MODEL_VERSION=1.0.0

# Optional Background Task Engine (Celery/Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Timezone & Localization
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us

# ==============================================================================
# Phase 1: Authentication, OTP Verification & CAPTCHA Security Configuration
# ==============================================================================
# Set to True for development mode (safe console logging of OTPs, mock CAPTCHA)
# Set to False in production
DEBUG=True

# CAPTCHA Protection (Turnstile / Google reCAPTCHA)
CAPTCHA_ENABLED=False
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=your_captcha_site_key_here
CAPTCHA_SECRET_KEY=your_captcha_secret_key_here

# Email Verification Provider (SMTP) - Optional in dev (falls back to safe console logging)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=GrievanceHUB <noreply@grievancehub.in>

# Frontend Client URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173
