{
  "model_name": "TF-IDF + Multinomial Naive Bayes",
  "model_type": "baseline",
  "version": "1.0.0",
  "random_state": 42,
  "feature_extraction": {
    "vectorizer": "TfidfVectorizer",
    "ngram_range": [1, 2],
    "min_df": 2,
    "max_df": 0.85,
    "max_features": 10000,
    "sublinear_tf": true,
    "norm": "l2",
    "stop_words": "english",
    "lowercase": true,
    "strip_accents": "unicode"
  },
  "hyperparameters": {
    "alpha": 0.1,
    "fit_prior": true
  },
  "target_classes": [
    "Drainage and Sewage",
    "General Civic Services",
    "Parks and Environment",
    "Roads and Infrastructure",
    "Sanitation and Waste Management",
    "Street Lighting and Electrical Infrastructure",
    "Transportation and Traffic Infrastructure",
    "Water Supply"
  ]
}
